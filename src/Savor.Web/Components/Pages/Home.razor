@page "/"

<PageTitle>Savor | Recipe discovery</PageTitle>

<section class="hero hero--home">
    <p class="eyebrow">Savor every ingredient</p>
    <h1>Find your next favorite meal.</h1>
    <p>Discover recipes, save your own creations, and make cooking feel simple.</p>
    <div class="hero__actions">
        <a class="button-link" href="/recipes">Browse recipes</a>
        <a class="button-link button-link--secondary" href="/register">Join Savor</a>
    </div>
</section>

<section class="feature-grid">
    <article>
        <span class="feature-icon">01</span>
        <h2>Discover</h2>
        <p>Explore public recipes with simple ingredient and tag filters.</p>
    </article>
    <article>
        <span class="feature-icon">02</span>
        <h2>Create</h2>
        <p>Keep your personal recipes private or share them with the community.</p>
    </article>
    <article>
        <span class="feature-icon">03</span>
        <h2>Cook</h2>
        <p>Turn the ingredients you have into something worth gathering around.</p>
    </article>
</section>
