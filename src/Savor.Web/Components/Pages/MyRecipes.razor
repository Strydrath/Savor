@page "/my-recipes"
@inject SavorApiClient Api
@inject NavigationManager Navigation

<PageTitle>My recipes | Savor</PageTitle>

<h1>My recipes</h1>
<p class="page-intro">Create and manage your personal recipe collection.</p>

@if (saved is not null)
{
    <p class="success-message">@saved</p>
}
<EditForm Model="model" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <div class="recipe-form">
        <label>Title <InputText @bind-Value="model.Title" /></label>
        <ValidationMessage For="() => model.Title" />
        <label>Description <InputTextArea @bind-Value="model.Description" /></label>
        <ValidationMessage For="() => model.Description" />
        <label><InputCheckbox @bind-Value="model.IsPublic" /> Make public</label>
        <button type="submit">@((editingId is null) ? "Create recipe" : "Save changes")</button>
        @if (editingId is not null) { <button type="button" @onclick="Reset">Cancel</button> }
    </div>
</EditForm>

@if (error is not null) { <p class="form-error">@error</p> }
@if (recipes.Count == 0)
{
    <p class="empty-state">You have not created any recipes yet.</p>
}
else
{
    <div class="recipe-grid">
        @foreach (var recipe in recipes)
        {
            <div class="recipe-card">
                <h2>@recipe.Title</h2>
                <p>@recipe.Description</p>
                <button @onclick="() => Edit(recipe)">Edit</button>
                <button class="button-secondary" @onclick="() => Delete(recipe.Id)">Delete</button>
            </div>
        }
    </div>
}

@code {
    private readonly List<RecipeResponse> recipes = [];
    private RecipeForm model = new();
    private Guid? editingId;
    private string? error;
    private string? saved;

    protected override async Task OnInitializedAsync()
    {
        var user = await Api.GetCurrentUserAsync();
        if (user is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }
    }

    private async Task Save()
    {
        var request = new CreateRecipeRequest
        {
            Title = model.Title,
            Description = model.Description,
            Visibility = model.IsPublic ? RecipeVisibility.Public : RecipeVisibility.Private
        };
        RecipeResponse? result = editingId is null
            ? await Api.CreateRecipeAsync(request)
            : await Api.UpdateRecipeAsync(editingId.Value, new UpdateRecipeRequest
            {
                Title = request.Title,
                Description = request.Description,
                Visibility = request.Visibility
            });

        if (result is null) { error = "The recipe could not be saved."; return; }
        if (editingId is null) recipes.Add(result);
        else recipes[recipes.FindIndex(item => item.Id == result.Id)] = result;
        saved = "Recipe saved.";
        Reset();
    }

    private void Edit(RecipeResponse recipe)
    {
        editingId = recipe.Id;
        model = new RecipeForm { Title = recipe.Title, Description = recipe.Description };
    }

    private async Task Delete(Guid id)
    {
        if (await Api.DeleteRecipeAsync(id))
        {
            recipes.RemoveAll(item => item.Id == id);
            saved = "Recipe deleted.";
        }
    }

    private void Reset() { editingId = null; model = new(); }
    private sealed class RecipeForm
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Title { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.MaxLength(4000)]
        public string Description { get; set; } = string.Empty;
        public bool IsPublic { get; set; }
    }
}
